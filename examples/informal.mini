~> Exemplo: o simbolo informal que ainda existe por cima do vocabulario
~> oficial - o comentario "~>", alternativa descontraida ao "//" formal.
~> ("fala" e "mostrar" sao dois nomes oficiais pro mesmo comando de print.)

bool ligado = sim;
bool pausado = nao;

caso_isso (ligado) {
    fala("ta ligado!");
} se_nao_isso {
    mostrar("desligado");
}

// o comentario formal "//" continua funcionando igual:
bool ok = sim;
mostrar(ok);
